<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackTop.SettingsPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="{AppThemeBinding Light=#F6F6F8, Dark=#17171B}">
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="20,12,20,20">

            <!-- Заголовок -->
            <Label Text="Настройки"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#111111, Dark=White}"
                   Margin="0,0,0,14"/>

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#E8E8E8, Dark=#2A2A30}"
                     Margin="-20,0,-20,16"/>

            <!-- Карточка профиля -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    HeightRequest="110"
                    Padding="20"
                    Margin="0,0,0,16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Brush="#22000000"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.18"/>
                </Border.Shadow>
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="#5545e5" Offset="1.0" />
                        <GradientStop Color="#713ce7" Offset="0.5" />
                        <GradientStop Color="#8d34ea" Offset="0.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="70,*"
                      VerticalOptions="Center">
                    <Border WidthRequest="56"
                            HeightRequest="56"
                            BackgroundColor="#8366e9"
                            StrokeThickness="0"
                            Padding="0"
                            StrokeShape="RoundRectangle 28"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Image Source="account.png"
                               HorizontalOptions="Center"
                               WidthRequest="35"
                               HeightRequest="35">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="White" />
                            </Image.Behaviors>
                        </Image>
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="{Binding Username}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="Нажмите, чтобы изменить имя"
                               FontSize="15"
                               TextColor="#F2F2F2"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- АККАУНТ -->
            <Label Text="АККАУНТ"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#7C7C84, Dark=#9B93A8}"
                   Margin="4,0,0,10"/>

            <Border Stroke="{AppThemeBinding Light=#E7E7E7, Dark=#33333B}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#232329}"
                    StrokeShape="RoundRectangle 16"
                    Padding="14"
                    Margin="0,0,0,18">
                <Grid ColumnDefinitions="52,*,Auto"
                      ColumnSpacing="12"
                      VerticalOptions="Center">

                    <Border WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="{AppThemeBinding Light=#F4F4F5, Dark=#303038}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <Image Source="account.png"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               WidthRequest="25"
                               HeightRequest="25">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="DimGray" />
                            </Image.Behaviors>
                        </Image>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Username"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                        <Label Text="Нажмите для выхода"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#7B7B85, Dark=#A6A6B0}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- НАСТРОЙКИ -->
            <Label Text="НАСТРОЙКИ"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#7C7C84, Dark=#9B93A8}"
                   Margin="4,0,0,10"/>

            <Border Stroke="{AppThemeBinding Light=#E7E7E7, Dark=#33333B}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#232329}"
                    StrokeShape="RoundRectangle 16"
                    Padding="0"
                    Margin="0,0,0,18">

                <VerticalStackLayout Spacing="0">

                    <!-- Тема -->
                    <Grid ColumnDefinitions="52,*,Auto"
                          Padding="14,14,14,14"
                          ColumnSpacing="12">
                        <Border WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#F4F4F5, Dark=#303038}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Image Source="sunny.png"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   WidthRequest="25"
                                   HeightRequest="25">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="DimGray" />
                                </Image.Behaviors>
                            </Image>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Тема оформления"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                            <Label Text="Светлая тема"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#7B7B85, Dark=#A6A6B0}"
                                   x:Name="ThemeText"/>
                        </VerticalStackLayout>

                        <Switch Grid.Column="2"
                                x:Name="ThemeSwitch"
                                IsToggled="False"
                                OnColor="#5F43E9"
                                ThumbColor="White"
                                VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#EEEEEE"/>

                    <!-- Уведомления -->
                    <Grid ColumnDefinitions="52,*,Auto"
                          Padding="14,14,14,14"
                          ColumnSpacing="12">
                        <Border WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#F4F4F5, Dark=#303038}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Image Source="notifications.png"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   WidthRequest="25"
                                   HeightRequest="25">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="DimGray" />
                                </Image.Behaviors>
                            </Image>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Уведомления"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                            <Label Text="Включены"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#7B7B85, Dark=#A6A6B0}"
                                   x:Name="NotificationsText"/>
                        </VerticalStackLayout>

                        <Switch Grid.Column="2"
                                x:Name="NotificationsSwitch"
                                IsToggled="False"
                                OnColor="#5F43E9"
                                ThumbColor="White"
                                VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- СОЦИАЛЬНОЕ -->
            <Label Text="СОЦИАЛЬНОЕ"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#7C7C84, Dark=#9B93A8}"
                   Margin="4,0,0,10"/>

            <Border Stroke="{AppThemeBinding Light=#E7E7E7, Dark=#33333B}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#232329}"
                    StrokeShape="RoundRectangle 16"
                    Padding="14"
                    Margin="0,0,0,18">
                <Grid ColumnDefinitions="52,*,Auto"
                      ColumnSpacing="12">

                    <Border WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="{AppThemeBinding Light=#F4F4F5, Dark=#303038}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <Image Source="friends.png"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               WidthRequest="25"
                               HeightRequest="25">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="DimGray" />
                            </Image.Behaviors>
                        </Image>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Друзья"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                        <Label Text="Управление общими задачами"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#7B7B85, Dark=#A6A6B0}"/>
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="26"
                           TextColor="#A1A1AA"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- О ПРИЛОЖЕНИИ -->
            <Label Text="О ПРИЛОЖЕНИИ"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#7C7C84, Dark=#9B93A8}"
                   Margin="4,0,0,10"/>

            <Border Stroke="{AppThemeBinding Light=#E7E7E7, Dark=#33333B}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#232329}"
                    StrokeShape="RoundRectangle 16"
                    Padding="14"
                    Margin="0,0,0,20">
                <Grid ColumnDefinitions="52,*"
                      ColumnSpacing="12">

                    <Border WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="{AppThemeBinding Light=#F4F4F5, Dark=#303038}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <Image Source="shield.png"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               WidthRequest="25"
                               HeightRequest="25">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="DimGray" />
                            </Image.Behaviors>
                        </Image>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Версия"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                        <Label Text="0.1.0 (MVP)"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#7B7B85, Dark=#A6A6B0}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
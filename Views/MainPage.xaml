<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackTop.MainPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="{AppThemeBinding Light=White, Dark = DimGrey}">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Padding="10">
            <Label
                x:Name="MorningText"
                Text="Добро пожаловать!"
                FontSize="25"
                TextColor="{AppThemeBinding Light=Black, Dark = White}"/>
            <Label
                x:Name="UsernameText"
                Text="Username"
                FontSize="20"
                TextColor="{AppThemeBinding Light=Black, Dark = White}"/>
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Column="2" Grid.Row="0"  Spacing="10" HorizontalOptions="End" VerticalOptions="Center" Padding="10">
            <ImageButton
                x:Name="DarkModeButton"
                Source="dark_mode.png"
                HeightRequest="40"
                WidthRequest="40"
                CornerRadius="20"
                BackgroundColor="DarkOrchid"
                Clicked="ThemeSwitcher"/>
            <ImageButton
                x:Name="AvatarButton"
                Source="account_image.png"
                HeightRequest="40"
                WidthRequest="40"
                CornerRadius="20"
                BackgroundColor="DarkGrey"
                Clicked="OnAvatarClicked"/>
        </HorizontalStackLayout>
        <ScrollView Grid.Column="0" Grid.ColumnSpan="3" Grid.Row ="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout  Spacing="5" HorizontalOptions="Start" Padding="5">
                <Button Text="На сегодня"
                        FontSize="14"
                        ImageSource="calendar_image.png"
                        ContentLayout="Left, 5"
                        TextColor="{AppThemeBinding Light=Black, Dark = White}"
                        BackgroundColor="{AppThemeBinding Light=MediumPurple, Dark = MediumPurple}"
                        HeightRequest="40"
                        WidthRequest="140"
                        CornerRadius="25"/>
                <Button Text="Запланированные"
                        FontSize="14"
                        ImageSource="schedule_image.png"
                        ContentLayout="Left, 5"
                        TextColor="{AppThemeBinding Light=Black, Dark = White}"
                        BackgroundColor="{AppThemeBinding Light=MediumPurple, Dark = MediumPurple}"
                        HeightRequest="40"
                        WidthRequest="180"
                        CornerRadius="25"/>
                <Button Text="Заметки"
                        FontSize="14"
                        ImageSource="notes_image.png"
                        ContentLayout="Left, 5"
                        TextColor="{AppThemeBinding Light=Black, Dark = White}"
                        BackgroundColor="{AppThemeBinding Light=MediumPurple, Dark = MediumPurple}"
                        HeightRequest="40"
                        WidthRequest="120"
                        CornerRadius="25"/>
            </HorizontalStackLayout>
        </ScrollView>
        <HorizontalStackLayout Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" HorizontalOptions="Center" VerticalOptions="End" Padding="50" Spacing="12">
            <Button BackgroundColor="{AppThemeBinding Light=White, Dark=Gray}"
                    ImageSource="plus_image.png"
                    HeightRequest="40"
                    WidthRequest="40"
                    CornerRadius="20"
                    Clicked="OnOpenPopupClicked">
                <Button.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="Black" />
                </Button.Behaviors>
            </Button>
            <ImageButton x:Name="MicButton"
                    BackgroundColor="{AppThemeBinding Light=#FF512BD4, Dark=#FFAC99EA}"
                    Source="mic_image.png"
                    CornerRadius="32,5"
                    HeightRequest="65"
                    WidthRequest="65"
                    Padding="15"
                    Clicked="Listen">
            </ImageButton>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>

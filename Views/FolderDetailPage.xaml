<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackTop.Views.FolderDetailPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="{AppThemeBinding Light=#F7F7FA, Dark=#1F1F23}">

    <Grid RowDefinitions="Auto,*">

        <!-- Шапка -->
        <Grid Grid.Row="0"
              Padding="18,16,18,12"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">

            <Border WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="{AppThemeBinding Light=#F0EEFF, Dark=#2F2A3E}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    VerticalOptions="Center">
                <Label Text="&#xE5C4;"
                       FontFamily="MaterialIcons"
                       FontSize="22"
                       TextColor="{AppThemeBinding Light=#4B3FD6, Dark=#B4A8FF}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 VerticalOptions="Center">
                <Label Text="{Binding FolderName}"
                       FontSize="22"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light=#161616, Dark=White}" />
                <Label x:Name="TasksCountLabel"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#7B7B84, Dark=#C9C9CF}" />
            </VerticalStackLayout>

            <Border Grid.Column="2"
                    WidthRequest="42"
                    HeightRequest="42"
                    Padding="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 13"
                    BackgroundColor="{Binding IconBackground}"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                <Label Text="&#xE8B7;"
                       FontFamily="MaterialIcons"
                       FontSize="22"
                       TextColor="{Binding IconColor}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Список задач -->
        <Grid Grid.Row="1"
              Padding="18,6,18,20">

            <CollectionView x:Name="TasksCollection"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A30}"
                                Stroke="{AppThemeBinding Light=#ECECF0, Dark=#36363D}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,12">

                            <Border.Shadow>
                                <Shadow Brush="#14000000"
                                        Offset="0,3"
                                        Radius="10"
                                        Opacity="0.12" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">

                                <Border WidthRequest="22"
                                        HeightRequest="22"
                                        Stroke="{Binding IconColor}"
                                        StrokeThickness="1.5"
                                        BackgroundColor="Transparent"
                                        StrokeShape="RoundRectangle 11"
                                        VerticalOptions="Start" />

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{Binding Title}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#191919, Dark=White}" />

                                    <Label Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#777783, Dark=#C9C9CF}" />

                                    <Label Text="{Binding TimeString}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#8B8B95, Dark=#BEBEC6}" />
                                </VerticalStackLayout>

                                <ImageButton Grid.Column="2"
                                        Source="delete.png"
                                        BackgroundColor="#E5484D"
                                        HeightRequest="30"
                                        WidthRequest="30"
                                        CornerRadius="15"
                                        Padding="7"
                                        VerticalOptions="Start"
                                        Clicked="OnDeleteTaskTapped">
                                    <ImageButton.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="White" />
                                    </ImageButton.Behaviors>
                                </ImageButton>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Пустое состояние -->
            <VerticalStackLayout x:Name="EmptyStateLayout"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="10"
                                 IsVisible="False">

                <Border WidthRequest="72"
                        HeightRequest="72"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F5, Dark=#2B2B31}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 36"
                        HorizontalOptions="Center">

                    <Image Source="folder_image.png"
                           WidthRequest="34"
                           HeightRequest="34"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{Binding IconColor}" />
                        </Image.Behaviors>
                    </Image>
                </Border>

                <Label Text="В папке нет задач"
                       FontSize="17"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#1D1D1F, Dark=White}" />

                <Label Text="Задачи, добавленные в эту папку, появятся здесь"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#80808A, Dark=#C7C7CE}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
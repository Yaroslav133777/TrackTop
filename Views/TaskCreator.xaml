<?xml version="1.0" encoding="utf-8"?>
 
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackTop.Views.TaskCreator"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <Border x:Name="PopupCard"
            WidthRequest="360"
            Padding="0"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 22">
 
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0" Padding="20,18,20,14" ColumnDefinitions="*,Auto">
                <Label
                    Text="Новая задача"
                    FontSize="24"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    TextColor="Black"/>
            </Grid>
            <VerticalStackLayout Grid.Row="1">
                <VerticalStackLayout Padding="20" Spacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Название задачи"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#3A3A3A" />
                        <Editor
                            x:Name="TaskEditor"
                            Placeholder="Опишите задачу..."
                            AutoSize="TextChanges"
                            HeightRequest="90"
                            BackgroundColor="#FAFAFA"
                            TextColor="Black"/>
                    </VerticalStackLayout>
                    <Button
                        Text="✦ Оптимизировать текст ИИ"
                        TextColor="#6B5CF6"
                        FontAttributes="Bold"
                        FontSize="14"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="3">
                                <Image Source="calendar_image.png">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="Black" />
                                    </Image.Behaviors>
                                </Image>
                                <Label Text="Дата"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="Black"/>
                            </HorizontalStackLayout>
                            <Border Stroke="#D9D9D9"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12,6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <DatePicker x:Name="TaskDatePicker"
                                                Format="dd.MM.yyyy"
                                                BackgroundColor="Transparent"
                                                TextColor="Black"/>
                                    <Image Grid.Column="1"
                                             Source="date_range.png"
                                             BackgroundColor="Transparent"
                                             WidthRequest="28"
                                             HeightRequest="28"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <HorizontalStackLayout Spacing="2">
                                <Image Source="clock.png">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="Black" />
                                    </Image.Behaviors>
                                </Image>
                                <Label Text="Время"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="Black"/>
                            </HorizontalStackLayout>
                            <Border Stroke="#D9D9D9"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12,6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TimePicker x:Name="TaskTimePicker"
                                                Format="HH:mm"
                                                BackgroundColor="Transparent"
                                                TextColor="Black"/>
                                    <Image Grid.Column="1"
                                             Source="clock.png"
                                             BackgroundColor="Transparent"
                                             WidthRequest="28"
                                             HeightRequest="28"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Папка"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="Black"/>
                        <Border Stroke="#D9D9D9"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,2">
                            <Picker TextColor="Black" x:Name="FoldersPicker"
                                    Title="Выберите папку">
                            </Picker>
                        </Border>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                        <Label Text="Регулярная задача"
                               VerticalOptions="Center" 
                               TextColor="Black"/>
                        <Switch Grid.Column="1" 
                                OffColor="#D9D9D9"
                                OnColor="#2F2F2F"
                                ThumbColor="White"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,6">
                        <Label Text="Без уведомления"
                               VerticalOptions="Center" 
                               TextColor="Black"/>
                        <Switch Grid.Column="1"
                                x:Name="NotifySwitch"
                                OffColor="#D9D9D9"
                                OnColor="#2F2F2F"
                                ThumbColor="White"/>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12"
                  Padding="20,10,20,20">
                <Button
                    Text="Отмена"
                    BackgroundColor="White"
                    TextColor="#6B5CF6"
                    BorderColor="#6B5CF6"
                    BorderWidth="1"
                    CornerRadius="12"
                    HeightRequest="50"
                    Clicked="ClosePage"/>
                <Button
                    Grid.Column="1"
                    Text="Создать"
                    BackgroundColor="#6B5CF6"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    Clicked="CreateTask"/>
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>
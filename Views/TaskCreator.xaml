<?xml version="1.0" encoding="utf-8"?>

<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackTop.Views.TaskCreator"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
     <Border
        WidthRequest="360"
        Padding="0"
        BackgroundColor="White"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 22">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <Grid Grid.Row="0" Padding="20,18,20,14" ColumnDefinitions="*,Auto">
                <Label
                    Text="Новая задача"
                    FontSize="24"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />

                <ImageButton
                    Grid.Column="1"
                    Source="close.png"
                    BackgroundColor="Transparent"
                    WidthRequest="22"
                    HeightRequest="22"/>
            </Grid>

            <BoxView Grid.Row="0"
                     VerticalOptions="End"
                     HeightRequest="1"
                     Color="#E5E5E5" />

            <!-- Content -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20" Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Название задачи"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#3A3A3A" />
                        <Editor
                            x:Name="TaskEditor"
                            Placeholder="Опишите задачу..."
                            AutoSize="TextChanges"
                            HeightRequest="90"
                            BackgroundColor="#FAFAFA" />
                    </VerticalStackLayout>

                    <Label
                        Text="✦ Оптимизировать текст ИИ"
                        TextColor="#6B5CF6"
                        FontAttributes="Bold"
                        FontSize="14" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Дата"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                            <Border Stroke="#D9D9D9"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12,6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <DatePicker x:Name="TaskDatePicker"
                                                Format="dd.MM.yyyy"
                                                BackgroundColor="Transparent" />
                                    <ImageButton Grid.Column="1"
                                                 Source="calendar.png"
                                                 BackgroundColor="Transparent"
                                                 WidthRequest="18"
                                                 HeightRequest="18"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Время"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                            <Border Stroke="#D9D9D9"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12,6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TimePicker x:Name="TaskTimePicker"
                                                Format="HH:mm"
                                                BackgroundColor="Transparent" />
                                    <ImageButton Grid.Column="1"
                                                 Source="clock.png"
                                                 BackgroundColor="Transparent"
                                                 WidthRequest="18"
                                                 HeightRequest="18"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Папка"
                            FontSize="14"
                            FontAttributes="Bold" />
                        <Border Stroke="#D9D9D9"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,2">
                            <Picker Title="Без папки">
                                <Picker.Items>
                                    <x:String>Без папки</x:String>
                                    <x:String>Учёба</x:String>
                                    <x:String>Работа</x:String>
                                    <x:String>Дом</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                        <Label Text="Регулярная задача"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,6">
                        <Label Text="Без уведомления"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Footer -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12"
                  Padding="20,10,20,20">

                <Button
                    Text="Отмена"
                    BackgroundColor="White"
                    TextColor="#6B5CF6"
                    BorderColor="#6B5CF6"
                    BorderWidth="2"
                    CornerRadius="12"
                    HeightRequest="50"/>

                <Button
                    Grid.Column="1"
                    Text="Создать"
                    BackgroundColor="#A89AF7"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"/>
            </Grid>
        </Grid>
    </Border>
